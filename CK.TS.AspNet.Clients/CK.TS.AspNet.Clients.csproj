<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The publication of the client applications of a host (it reaches the host through its ".App" project). -->
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dev server of a client application is reached through the host by YARP direct forwarding. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- The "Enable" convention and the contributions of the packages (WebApplicationContributions). -->
    <PackageReference Include="CK.AspNet" Version="25.0.0-0.uc.3.ci.70" />
    <!-- The client applications are clients of a party ("PartyClient" feature); they require its "HttpEndpoint" feature. -->
    <PackageReference Include="CK.AppIdentity.PartyClient" Version="3.0.0-0.uc.3.ci.178" />
    <PackageReference Include="CK.AppIdentity.HttpEndpoint" Version="25.0.0-0.uc.3.ci.70" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CK.TypeScript" Version="4.0.0-0.uc.3.ci.60" />
  </ItemGroup>
</Project>
